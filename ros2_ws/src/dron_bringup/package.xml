<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dron_bringup</name>
  <version>1.0.0</version>
  <description>Launch scripts and configurations for DRON 3D thermal mapping</description>
  <maintainer email="dev@dron.local">DRON Visualization Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>dron_capture</exec_depend>
  <exec_depend>dron_mapping</exec_depend>
  <exec_depend>dron_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
